#!/usr/bin/env bash
# Cutroom: start the API and the web app, then open the browser. Ctrl-C stops both.
#
#   ./cutroom              your workspace, your logged-in Claude Code as the brain
#   ./cutroom --demo       a separate demo workspace (.demo/) with a scripted brain: no Claude calls
#   ./cutroom --no-open    don't open the browser
#
# Ports: CUTROOM_API_PORT (default 8000) and CUTROOM_APP_PORT (default 5173).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

OPEN=1
DEMO=0
for a in "$@"; do
  case "$a" in
    --demo) DEMO=1 ;;
    --no-open) OPEN=0 ;;
    -h | --help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $a (try --help)" >&2; exit 2 ;;
  esac
done

API_PORT="${CUTROOM_API_PORT:-8000}"
APP_PORT="${CUTROOM_APP_PORT:-5173}"
export CUTROOM_API_PORT="$API_PORT" CUTROOM_APP_PORT="$APP_PORT"

say() { printf '\033[1;35m▸\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }

PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || die "No Python environment yet: run scripts/setup.sh first."
command -v node >/dev/null || die "Node isn't installed: brew install node"
if [ ! -d "$ROOT/app/node_modules" ]; then
  say "Installing the app's packages (first run only)…"
  npm --prefix "$ROOT/app" install --no-audit --no-fund
fi

listening() { lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }
listening "$API_PORT" && die "Port $API_PORT is already in use (another Cutroom?). Stop it, or set CUTROOM_API_PORT."
listening "$APP_PORT" && die "Port $APP_PORT is already in use. Stop it, or set CUTROOM_APP_PORT."

if [ "$DEMO" = 1 ]; then
  D="$ROOT/.demo"
  mkdir -p "$D/workspace"
  [ -f "$D/brand.md" ] || cp "$ROOT/brand.md" "$D/brand.md"
  [ -d "$D/presets" ] || cp -R "$ROOT/presets" "$D/presets"
  export CUTROOM_BRAIN=demo CUTROOM_WORKSPACE="$D/workspace" CUTROOM_BRAND="$D/brand.md" CUTROOM_PRESETS="$D/presets"
  say "Demo mode: scripted brain, separate workspace in .demo/ (your projects and brand.md are untouched)"
fi

pids=()
cleanup() {
  trap - EXIT INT TERM
  for p in ${pids[@]+"${pids[@]}"}; do kill "$p" 2>/dev/null || true; done
  wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

"$PY" -m uvicorn server.app:app --host 127.0.0.1 --port "$API_PORT" --log-level warning &
pids+=($!)
npm --prefix "$ROOT/app" run dev --silent -- --port "$APP_PORT" --strictPort --clearScreen false --logLevel warn &
pids+=($!)

up=0
for _ in $(seq 1 80); do
  if curl -sf "http://127.0.0.1:$API_PORT/" >/dev/null 2>&1 && curl -sf "http://localhost:$APP_PORT/" >/dev/null 2>&1; then
    up=1
    break
  fi
  for p in "${pids[@]}"; do kill -0 "$p" 2>/dev/null || die "Cutroom couldn't start (see the error above)."; done
  sleep 0.25
done
[ "$up" = 1 ] || die "Cutroom didn't come up within 20 seconds."

URL="http://localhost:$APP_PORT"
say "Cutroom is running at $URL   (API http://127.0.0.1:$API_PORT/docs)   Ctrl-C to stop"
if [ "$OPEN" = 1 ]; then
  if command -v open >/dev/null; then open "$URL"; elif command -v xdg-open >/dev/null; then xdg-open "$URL"; fi
fi

# stop everything when either process exits
while :; do
  for p in "${pids[@]}"; do
    if ! kill -0 "$p" 2>/dev/null; then
      say "A Cutroom process stopped; shutting down."
      exit 1
    fi
  done
  sleep 1
done
