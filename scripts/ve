#!/usr/bin/env bash
# One entry point for the pipeline (a thin wrapper over the engine package). Run from anywhere:
#   scripts/ve brief briefs/my-video.md          read brief + preset + brand, list gaps
#   scripts/ve presets                           list content-type presets
#   scripts/ve ref my-video <url> [--cookies chrome]   REFERENCE mode: download + analyse reel
#   scripts/ve media raw/shoot-oct/              list a folder in capture order
#   scripts/ve transcribe raw/a.mp4 [--show]     word-level transcript (cached; folders ok)
#   scripts/ve vo voiceover/vo.m4a [--force]     clean a voiceover (noise, de-ess, compression, -16 LUFS) + transcript
#   scripts/ve draft my-video raw/a.mp4 raw/folder/ [--preset X --music Y --talk no --vo voiceover/v.m4a]   draft plan
#   scripts/ve moments raw/a.mp4                 best no-talk moments in a clip
#   scripts/ve plan my-video [--cuts]            timeline preview of work/my-video/edl.json
#   scripts/ve render my-video [--draft]         export output/my-video.mp4 + contact sheet
#   scripts/ve faces raw/a.mp4 [--preview]       check face tracking on a clip
#   scripts/ve beats music/track.mp3             BPM, beats, downbeats, drops
#   scripts/ve sheet output/x.mp4 [--times ..]   contact sheet for any video
#   scripts/ve sfx                               (re)generate the starter SFX kit
#   scripts/ve doctor                            check every tool is installed
#   scripts/ve import briefs/my-video.md         create a Cutroom project from a brief
#   scripts/ve serve                             start the Cutroom API (http://127.0.0.1:8000/docs)
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export OPENCV_LOG_LEVEL=ERROR PYTHONUNBUFFERED=1
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
cd "$ROOT"
exec "$ROOT/.venv/bin/python" -m engine.cli "$@"
